# Process-name signatures of firebase-tools' own children. firebase-tools spawns
# these `detached: true` — their OWN process groups — so killpg on the suite can
# structurally never reach them (the v1 "killpg fixes it" assumption was wrong:
# it fixed the storage-rules JVM, which stays in-group, and missed the firestore
# JVM and every functions worker). Once their node parent dies they re-parent to
# pid 1; that ancestry is the sweep's orphan test.
SWEEP_SIGNATURES = ("functionsEmulatorRuntime", "cloud-firestore-emulator",
                    "cloud-storage-rules-runtime", "pubsub-emulator",
                    "cloud-datastore-emulator", "firebase-database-emulator")
# Authorship, not resemblance. v0.8.1 killed pool-port listeners that "looked
# lease-shaped" (node/java/python) — a profile, and profiles convict bystanders
# (0.8.0's broader rule killed ollama, whose 11434 sits inside the default
# pool). The only honest kill test is "harbormaster started this", so that is
# what gets recorded: while a lease's root process is alive, its detached
# children still report it as ppid (setsid changes the group, not the parent),
# and the reaper tick snapshots that descendant tree — (pid, start-time), start
# checked again before any signal so a recycled pid is never a stranger's
# death warrant. Teardown kills the recorded tree; the world sweep evicts only
# what it can positively attribute: a recorded pid, or a cmdline naming the
# injected config file harbormaster itself wrote (.firebase.brokered-*).
# Everything else — signature-matched orphans included — is reported by
# doctor and never signalled. The env-marker alternative is off the table on
# macOS: KERN_PROCARGS2 hides other processes' environments even same-user.
def _ps_table():
    """{pid: (ppid, lstart)} for every visible process, one ps call."""
    table = {}
    try:
        r = subprocess.run(["ps", "-axo", "pid=,ppid=,lstart="],
                           capture_output=True, text=True, timeout=10)
        for line in r.stdout.splitlines():
            parts = line.split(None, 2)
            if len(parts) == 3:
                table[int(parts[0])] = (int(parts[1]), parts[2].strip())
    except (subprocess.SubprocessError, OSError, ValueError):
        pass
    return table


def _descendants(root, table):
    """{pid: lstart} of every process reachable from root via ppid edges."""
    kids = {}
    for pid, (ppid, _) in table.items():
        kids.setdefault(ppid, []).append(pid)
    out, frontier = {}, [int(root)]
    while frontier:
        p = frontier.pop()
        for c in kids.get(p, ()):
            if c not in out:
                out[c] = table[c][1]
                frontier.append(c)
    return out


def _now():
    return datetime.now(timezone.utc).isoformat(timespec="seconds")


def _port_open(port, host="127.0.0.1"):
    with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as s:
        s.settimeout(0.5)
        return s.connect_ex((host, int(port))) == 0


# THE PORTS DOCKER PUBLISHES, asked of docker itself. A connect is not enough:
# on Linux dockerd publishes a container's port through iptables and, with no
# userland proxy, nothing LISTENS on it — `_port_open` finds the port quiet
# while a container holds it. Simon Says' local Supabase stacks (20-port blocks,
# one per job) are containers; on simon-linux-1 (2026-10-09) four jobs in a row
# were handed a block a stack still held and died on "address already in use".
# One `docker ps` per allocation; no docker, or one that will not answer, is the
# empty set — never a failure.
_PUBLISHED_RE = re.compile(r":(\d+)(?:-(\d+))?->")


def _parse_published(text):
    out = set()
    for m in _PUBLISHED_RE.finditer(text or ""):
        a = int(m.group(1)); b = int(m.group(2)) if m.group(2) else a
        out.update(range(a, min(b, a + 999) + 1))
    return out


def _docker_published_ports():
    try:
        r = subprocess.run(["docker", "ps", "--format", "{{.Ports}}"], capture_output=True, text=True, timeout=10)
        return _parse_published(r.stdout) if r.returncode == 0 else set()
    except (OSError, subprocess.SubprocessError):
        return set()


def _all_open(ports):
    return bool(ports) and all(_port_open(p) for p in ports.values())


def _pid_alive(pid):
    try:
        os.kill(int(pid), 0)
        return True
    except PermissionError:
        return True                       # EPERM: exists, just not ours to signal
    except (OSError, ProcessLookupError, ValueError, TypeError):
        return False


def _child_alive(pid):
    """Liveness for a process the DAEMON spawned. A zombie child passes kill-0
    until someone waits on it, so reap it first (WNOHANG); if it exited, it's
    dead. After a daemon restart the process is no longer our child
    (ECHILD) — launchd reaps it instead, so plain kill-0 is then correct."""
    try:
        done, _ = os.waitpid(int(pid), os.WNOHANG)
        if done == int(pid):
            return False
    except (ChildProcessError, OSError, ValueError, TypeError):
        pass
    return _pid_alive(pid)


def _proc_start(pid):
    """A process's start time — pairs with the PID to survive PID reuse. '' if gone."""
    try:
        r = subprocess.run(["ps", "-o", "lstart=", "-p", str(int(pid))],
                           capture_output=True, text=True, timeout=2)
        return r.stdout.strip()
    except (subprocess.SubprocessError, ValueError, TypeError):
        return ""


# Ancestors that exit with (or just before) the script asking for a lease, so
# owning a lease by one of them would reap it seconds later. `--owner auto`
# walks past these looking for something that outlives the call.
_TRANSIENT_COMMS = {"sh", "bash", "zsh", "dash", "fish", "ksh", "login", "env",
                    "node", "npm", "npx", "yarn", "pnpm", "bun", "make", "xargs"}
# Walking past *these* would hand ownership to something that outlives the work
# by days (your editor, your login session), which reaps nothing in practice.
# Better to record no owner and fall back to TTL + working-dir checks.
_BOUNDARY_COMMS = {"launchd", "Code", "Code Helper", "Code Helper (Plugin)",
                   "Code Helper (Renderer)", "Electron", "Terminal", "iTerm2",
                   "WindowServer", "sshd", "init", "systemd"}


def _proc_field(pid, fmt):
    try:
        r = subprocess.run(["ps", "-o", fmt, "-p", str(int(pid))],
                           capture_output=True, text=True, timeout=2)
        return r.stdout.strip()
    except (subprocess.SubprocessError, ValueError, TypeError):
        return ""


def _durable_ancestor(pid, _max_hops=16):
    """The nearest ancestor of `pid` that will outlive the calling script.

    A daemon-spawned lease (`--spawn`) deliberately survives the shell that
    asked for it, so that shell's pid is useless as an owner — it exits within
    seconds and would take the lease with it. But "daemonised" only decides who
    *reaps the child*; we can still record who is *interested*. Walking up past
    the transient shell/node wrappers finds that process: under an agent it is
    the agent itself, so its leases die with the session.

    Returns None when the walk reaches a boundary (an editor, a login session)
    rather than pretending a days-long process is a meaningful owner.
    """
    seen = pid
    for _ in range(_max_hops):
        ppid = _proc_field(seen, "ppid=")
        if not ppid or not ppid.isdigit() or int(ppid) <= 1:
            return None
        seen = int(ppid)
        comm = os.path.basename(_proc_field(seen, "comm="))
        if not comm or comm in _BOUNDARY_COMMS:
            return None
        if comm not in _TRANSIENT_COMMS:
            return seen
    return None


def _owner_alive(pid, start):
    """A lease's owner is alive iff the same PID exists AND was started at the same time."""
    if pid is None:
        return True                       # no owner tracking → rely on TTL / liveness
    if not _pid_alive(pid):
        return False
    if not start:
        return True
    observed = _proc_start(pid)
    # `ps` can time out on a loaded machine (exactly when a lease is booting).
    # An unreadable start time is NOT evidence of PID reuse — the pid exists
    # (os.kill(0) just succeeded), so treat indeterminate as alive rather than
    # reaping a healthy lease.
    return not observed or observed == start


def _tail(path, n=25):
    try:
        return "\n".join(Path(path).read_text().splitlines()[-n:])
    except OSError:
        return ""


def _firebaserc_project(cwd):
    try:
        return json.loads((Path(cwd) / ".firebaserc").read_text()).get("projects", {}).get("default")
    except (OSError, json.JSONDecodeError, AttributeError):
        return None


def _find_firebase_dir(start):
    p = Path(start).resolve()
    for d in [p, *p.parents]:
        if (d / "firebase.json").exists():
            return str(d)
    return None


def _block_ports(base):
    return {svc: base + off for svc, off in BLOCK_OFFSETS.items()}


def _service_ports(ports):
    return {s: p for s, p in ports.items()
            if s not in IMPLICIT_EMULATORS and s not in ("metro", "android_console", "android_adb")}


# A value that names a LEASED port: `{port:firestore}` becomes this lease's
# firestore port. The caller cannot know its ports before the lease, and an
# app whose functions read their own variable for the emulator (Tapuat's
# admin.ts: `127.0.0.1:${EMULATOR_PORT_FIRESTORE || "8080"}`, unconditionally)
# otherwise talks to whatever holds the default — on simon-linux-1, nothing;
# every callable 500'd (run 20261021-131438-exploration-everyday-user). An
# unknown service is left as written, so a typo shows in the app's own error.
_PORT_REF = re.compile(r"\{port:([a-z_]+)\}")

def _android_env(ports):
    """What a caller (and a --spawn'd process) is told about a leased Android
    pair: boot with `emulator -port $ANDROID_CONSOLE_PORT`, talk to it as
    $ANDROID_SERIAL (adb's name for the instance; adb itself honours it)."""
    c = ports["android_console"]
    return {"ANDROID_CONSOLE_PORT": str(c), "ANDROID_ADB_PORT": str(ports["android_adb"]),
            "ANDROID_SERIAL": f"emulator-{c}"}


def _with_ports(env, ports):
    return {k: _PORT_REF.sub(lambda m: str(ports[m.group(1)]) if m.group(1) in ports else m.group(0), v)
            for k, v in env.items()}


def _emulator_targets(cfg):
    """The service emulators firebase-tools would start for this config with no
    --only: a product named at the top level or under `emulators`."""
    emu = cfg.get("emulators") or {}
    return [s for s in SERVICE_EMULATORS if s in cfg or s in emu]


def _write_injected_config(cwd, ports, only=None):
    """Put EVERY port the CLI may bind for this config on the block: each
    emulator the config starts (a product at the top level or under
    `emulators`), the ones the CLI starts unasked (IMPLICIT_EMULATORS), and the
    second ports (SECOND_PORTS). Never adds a service emulator the project
    doesn't use — an `emulators.<x>` entry makes the CLI start <x>. A declared
    emulator with no offset is refused by name (ValueError): no lease, no port.
    Returns the temp config basename.

    With an --only that leaves hosting out, the `hosting` block goes too: no
    emulator a lease starts serves it, and firebase-tools still READS it. A
    web-framework target (`"source": "."`, a Next.js app) makes 15.33 refuse to
    start ANY emulator without the webframeworks experiment — Tapuat's run
    20261021-130009-exploration-everyday-user died there on simon-linux-1 while
    15.28 on the studio never checked."""
    cfg = json.loads((Path(cwd) / "firebase.json").read_text())
    emu = cfg.setdefault("emulators", {})
    if only and "hosting" not in only:
        cfg.pop("hosting", None)
        emu.pop("hosting", None)
    known = set(SERVICE_EMULATORS) | set(IMPLICIT_EMULATORS) | set(NOT_EMULATORS)
    unknown = [k for k, v in emu.items() if k not in known and isinstance(v, dict)
               and (not only or k in only)]
    if unknown:
        raise ValueError(f"firebase.json declares emulator(s) harbormaster has no port for: "
                         f"{', '.join(unknown)} — add them to BLOCK_OFFSETS")
    if "ui" in emu and isinstance(emu["ui"], dict):
        emu["ui"]["enabled"] = True        # declared: wanted on (as before 0.15.0)
    for svc in [*_emulator_targets(cfg), *IMPLICIT_EMULATORS]:
        if not isinstance(emu.get(svc), dict):
            emu[svc] = {}
        emu[svc]["port"] = ports[svc]
    for (svc, key), name in SECOND_PORTS.items():
        # Only on an emulator that starts: a key under emulators.<svc> would
        # otherwise make the CLI start <svc>.
        if svc in emu:
            emu[svc][key] = ports[name]
    emu["singleProjectMode"] = True
    tmp = f".firebase.brokered-{ports['firestore']}.json"
    (Path(cwd) / tmp).write_text(json.dumps(cfg, indent=2))
    return tmp


# Simulator authorship. run-*/alloc-* NAMING is not attribution: two daemons
# on one machine (a test suite next to the production broker) each read the
# other's sims as their own strays and delete them — observed 2026-08-12, the
# production broker eating the e2e's fixtures within seconds. So every UDID
# this daemon creates is recorded in its own file, SEPARATE from the ledger:
# ledger loss must orphan leases, not attribution. Eviction requires the UDID
# to be in this registry; a matching name alone is reported, never deleted.
SIMS_FILE = STATE_DIR / "authored-sims.json"


def _authored_sims():
    try:
        return set(json.loads(SIMS_FILE.read_text()))
    except (OSError, json.JSONDecodeError):
        return set()


def _authored_sims_write(udids):
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    tmp = SIMS_FILE.with_suffix(f".tmp-{os.getpid()}-{threading.get_ident()}")   # see Broker._save
    tmp.write_text(json.dumps(sorted(udids)))
    tmp.replace(SIMS_FILE)


def _sim_create_boot(device, runtime, name):
    """Create a fresh iOS simulator, boot it, and return its UDID. The device is
    per-lease (unique name) so concurrent e2e runs never share one; reaped on
    lease teardown. Boots on a PINNED runtime so we don't pay a second OS image."""
    r = subprocess.run(["xcrun", "simctl", "create", name, device, runtime],
                       capture_output=True, text=True, timeout=120)
    if r.returncode != 0:
        raise RuntimeError(f"simctl create failed ({device} / {runtime}): {r.stderr.strip()}")
    udid = r.stdout.strip()
    # Recorded before the boot: a crash mid-boot must still leave the device
    # attributable, or nothing may ever delete it.
    _authored_sims_write(_authored_sims() | {udid})
    # boot is idempotent-ish (errors if already booted); bootstatus waits until ready.
    subprocess.run(["xcrun", "simctl", "boot", udid], capture_output=True, text=True, timeout=120)
    subprocess.run(["xcrun", "simctl", "bootstatus", udid, "-b"], capture_output=True, text=True, timeout=300)
    return udid


def _sim_udids():
    """The set of simulator UDIDs simctl knows, or None when indeterminate.
    simctl erroring/missing must never read as 'every sim is gone' — callers
    treat None as 'no evidence', mirroring _owner_alive's philosophy."""
    try:
        r = subprocess.run(["xcrun", "simctl", "list", "devices", "-j"],
                           capture_output=True, text=True, timeout=15)
        if r.returncode != 0:
            return None
        devices = json.loads(r.stdout).get("devices", {})
        return {d["udid"] for lst in devices.values() for d in lst if d.get("udid")}
    except (subprocess.SubprocessError, OSError, json.JSONDecodeError,
            AttributeError, TypeError):
        return None


def _sim_teardown(udid):
    """Shut down + delete a leased simulator. Returns True when the device is
    confirmed gone. A failed delete is NOT fatal — the world sweep retries any
    harbormaster-named device that has no lease — but it must be visible."""
    for args in (["shutdown", udid], ["delete", udid]):
        try:
            subprocess.run(["xcrun", "simctl", *args], capture_output=True, text=True, timeout=60)
        except (subprocess.SubprocessError, OSError):
            pass
    udids = _sim_udids()
    gone = udids is None or udid not in udids
    if gone and udid in _authored_sims():
        _authored_sims_write(_authored_sims() - {udid})
    return gone


def _sim_inventory():
    """{udid: name} for every simulator, or None when indeterminate."""
    try:
        r = subprocess.run(["xcrun", "simctl", "list", "devices", "-j"],
                           capture_output=True, text=True, timeout=15)
        if r.returncode != 0:
            return None
        devices = json.loads(r.stdout).get("devices", {})
        return {d["udid"]: d.get("name", "")
                for lst in devices.values() for d in lst if d.get("udid")}
    except (subprocess.SubprocessError, OSError, json.JSONDecodeError,
            AttributeError, TypeError):
        return None


def _etime_s(etime):
    """ps etime ([[dd-]hh:]mm:ss) in seconds, or None."""
    try:
        days, _, rest = etime.strip().rpartition("-")
        parts = [int(x) for x in rest.split(":")]
        while len(parts) < 3:
            parts.insert(0, 0)
        return (int(days) if days else 0) * 86400 + parts[0] * 3600 + parts[1] * 60 + parts[2]
    except (ValueError, AttributeError):
        return None


_DEVICE_RE = re.compile(r"/CoreSimulator/Devices/([0-9A-Fa-f-]{36})/")


def _booted_sims(ps_text):
    """{udid: {"upS": seconds its launchd_sim has run, "app": an app is running}}
    for every booted simulator, read off one `ps -axo etime=,command=` listing.
    A device's launchd_sim is its boot; a process under its
    data/Containers/Bundle/Application is an app running in it."""
    out = {}
    for line in ps_text.splitlines():
        etime, _, cmd = line.strip().partition(" ")
        m = _DEVICE_RE.search(cmd)
        if not m:
            continue
        udid = m.group(1).upper()
        d = out.setdefault(udid, {"upS": None, "app": False})
        if "launchd_sim" in cmd.split(" ", 1)[0]:
            up = _etime_s(etime)
            if up is not None:
                d["upS"] = max(d["upS"] or 0, up)
        if "/data/Containers/Bundle/Application/" in cmd:
            d["app"] = True
    return out


def idle_unleased_sims(booted, leased, names, hours=IDLE_SIM_HOURS):
    """The booted simulators to shut down: no lease holds them, up longer than
    `hours`, and no app running. Pure. `names` is {udid: name} (for the report)."""
    if not hours or hours <= 0:
        return []
    out = []
    for udid, d in booted.items():
        if udid in leased or d.get("app") or d.get("upS") is None:
            continue
        if d["upS"] >= hours * 3600:
            out.append({"udid": udid, "name": names.get(udid, ""), "upH": round(d["upS"] / 3600, 1)})
    return out


_COMPANION_UDID_RE = re.compile(r"--udid[ =]([0-9A-Fa-f-]{36})")
_SOCK_RE = re.compile(r"^([0-9A-Fa-f-]{36})_companion\.sock$")


def _companions(ps_text):
    """[{pid, udid, upS}] for every idb_companion bound to one simulator, read off
    one `ps -xo pid=,etime=,command=` listing."""
    out = []
    for line in ps_text.splitlines():
        parts = line.split(None, 2)
        if len(parts) < 3 or "idb_companion" not in parts[2].split(" ", 1)[0]:
            continue
        m = _COMPANION_UDID_RE.search(parts[2])
        if not m:
            continue
        try:
            pid = int(parts[0])
        except ValueError:
            continue
        out.append({"pid": pid, "udid": m.group(1).upper(), "upS": _etime_s(parts[1])})
    return out


def dead_companions(companions, known, grace=COMPANION_GRACE_S):
    """The companions to end: their device is not in `known` (every simulator's
    UDID, upper-case) and they are older than `grace`. Pure."""
    return [c for c in companions
            if c["udid"] not in known and c.get("upS") is not None and c["upS"] >= grace]


def stale_companion_sockets(names, known, live):
    """The socket file names to remove: a device not in `known` that no live
    companion (`live`, UDIDs) holds. Pure."""
    out = []
    for n in names:
        m = _SOCK_RE.match(n)
        if m and m.group(1).upper() not in known and m.group(1).upper() not in live:
            out.append(n)
    return out


def _group_alive(pgid):
    """Any member of the process group left? EPERM counts as alive."""
    try:
        os.killpg(int(pgid), 0)
        return True
    except PermissionError:
        return True
    except (OSError, ProcessLookupError, ValueError, TypeError):
        return False


def _listeners():
    """{port: {pids}} for this user's TCP LISTEN sockets — ONE lsof call, so
    teardown and the world sweep can check whole port ranges cheaply."""
    out = {}
    try:
        r = subprocess.run(["lsof", "-nP", "-iTCP", "-sTCP:LISTEN", "-Fpn"],
                           capture_output=True, text=True, timeout=15)
        pid = None
        for line in r.stdout.splitlines():
            if line[:1] == "p":
                try:
                    pid = int(line[1:])
                except ValueError:
                    pid = None
            elif line[:1] == "n" and pid:
                try:
                    port = int(line.rsplit(":", 1)[1])
                except (ValueError, IndexError):
                    continue
                out.setdefault(port, set()).add(pid)
    except (subprocess.SubprocessError, OSError):
        pass
    return out


def _kill_wave(pids, wait=5.0):
    """SIGTERM the pids, wait, SIGKILL survivors. Returns the pids signalled.
    Never signals ourselves or anything system-side (pid <= 1)."""
    victims = sorted({int(p) for p in pids} - {os.getpid()})
    victims = [p for p in victims if p > 1]
    if not victims:
        return []
    for p in victims:
        try:
            os.kill(p, signal.SIGTERM)
        except (OSError, ProcessLookupError):
            pass
    deadline = time.time() + wait
    while time.time() < deadline and any(_pid_alive(p) for p in victims):
        time.sleep(0.1)
    for p in victims:
        if _pid_alive(p):
            try:
                os.kill(p, signal.SIGKILL)
            except (OSError, ProcessLookupError):
                pass
    return victims


# ---- the daemon ----------------------------------------------------------

class Broker:
    def __init__(self):
        self.lock = threading.RLock()
        self.leases = {}                  # leaseId -> caller-owned lease
        # Leases already reaped/released whose teardown is still running. The
        # lock guards the LEDGER only; the slow part of a teardown (process
        # group kills, simctl delete, rm -rf) runs outside it (0.17.0). Until
        # it finishes the block stays out of the pool — the teardown's port
        # sweep would kill whatever the next lease started on it.
        self.draining = {}
        self._load()
        self._reconcile()
        # _reconcile just swept; without this the reaper's throttle (epoch 0)
        # would fire a second "periodic" sweep on its first tick, making
        # FBPORTS_SWEEP_INTERVAL meaningless for the first interval.
        self._swept = time.time()

    def _load(self):
        if LEDGER.exists():
            try:
                saved = json.loads(LEDGER.read_text())
                self.leases = saved.get("leases", {})
                self.draining = saved.get("draining", {})
            except (json.JSONDecodeError, OSError) as e:
                # A silently-dropped ledger orphans every live suite/sim/port at
                # once. Quarantine it loudly; the world sweep adopts the fallout.
                quarantine = LEDGER.with_suffix(f".corrupt-{int(time.time())}")
                try:
                    LEDGER.rename(quarantine)
                except OSError:
                    pass
                print(f"ledger unreadable ({e}); quarantined to {quarantine} — "
                      f"world sweep will reap anything it was tracking", flush=True)

    def _save(self):
        STATE_DIR.mkdir(parents=True, exist_ok=True)
        # Atomic: a crash mid-write must never leave a half-written ledger
        # (see _load — a corrupt ledger orphans everything at once).
        # Per process: two writers sharing one ledger.tmp interleave into a
        # file json can't read ("Extra data"), and the loser's replace finds
        # it gone. cmd_serve's bind-first means only one broker writes; this
        # keeps any other writer from corrupting it.
        tmp = LEDGER.with_suffix(f".tmp-{os.getpid()}-{threading.get_ident()}")
        tmp.write_text(json.dumps({"leases": self.leases, "draining": self.draining}, indent=2))
        tmp.replace(LEDGER)

    def _reconcile(self):
        # A predecessor that died mid-teardown left its draining records in
        # the ledger: finish them (single-threaded here, nothing to race).
        for lid in list(self.draining):
            print(f"finishing teardown {lid} (predecessor stopped mid-teardown)", flush=True)
            self._cleanup(self.draining.pop(lid))
        for lid in list(self.leases):
            reason = self._dead_reason(self.leases[lid], time.time())
            if reason:
                print(f"reaping {lid}: {reason}", flush=True)
                self._cleanup(self.leases.pop(lid))
        self._record_trees()
        self._save()

    def _held(self):
        """Every record whose resources are still out there: live leases and
        the ones draining. Called under self.lock."""
        return list(self.leases.values()) + list(self.draining.values())

    def _retire(self, lid, why):
        """Under self.lock: take a lease out of service — the ledger no longer
        grants it — and park it in `draining` until _drain has torn it down.
        Cheap by construction; nothing here may block."""
        rec = self.leases.pop(lid, None)
        if rec is None:
            return None
        print(f"{why}", flush=True)
        self.draining[lid] = rec
        return rec

    def _drain(self, recs):
        """OUTSIDE self.lock: the slow half of a teardown. An allocate that
        arrives meanwhile is answered at once from the rest of the pool
        (2026-10-22, the studio: allocates queued behind a reaper teardown
        waited past the client's 30s, and were granted after it gave up)."""
        for rec in recs:
            if not rec:
                continue
            try:
                self._cleanup(rec)
            except Exception as e:
                print(f"teardown {rec.get('leaseId') or '?'} failed: {e}", flush=True)
            finally:
                with self.lock:
                    self.draining.pop(rec.get("leaseId"), None)
                    self._save()

    def _held_sets(self):
        """Under self.lock: what the world sweep must leave alone — every pid,
        port, simulator (by UDID or the name an in-flight create gives it) and
        recorded tree member a held record covers."""
        held = self._held()
        pids = {int(l["pid"]) for l in held if l.get("pid")}
        authored = {}
        ports = set()
        udids, names = set(), set()
        for l in held:
            for pid, start in (l.get("tree") or {}).items():
                authored[int(pid)] = start
            if l.get("block"):
                ports |= {l["block"] + off for off in range(BLOCK)}
            for k in ("android_console", "android_adb"):
                if isinstance((l.get("ports") or {}).get(k), int):
                    ports.add(l["ports"][k])
            if l.get("sim_udid"):
                udids.add(l["sim_udid"])
            if l.get("sim_name"):
                names.add(l["sim_name"])
        return {"pids": pids, "authored": authored, "ports": ports,
                "udids": udids, "names": names}

    def _record_trees(self):
        """Every tick, note which processes each live lease's root has fathered.
        This is the authorship ledger the teardown and sweep kill from: a
        detached child keeps its ppid while the parent lives, so polling while
        the suite is up sees the workers that killpg will later miss. Entries
        accumulate across polls (a worker seen once is remembered after it
        detaches); a recycled pid — same number, different start — is dropped,
        never inherited."""
        table = _ps_table()                    # outside the lock: ps is slow on a busy box
        if not table:
            return
        with self.lock:
            for rec in self.leases.values():
                root = rec.get("pid")
                if not root or root not in table:
                    continue
                tree = rec.setdefault("tree", {})
                for pid, start in _descendants(root, table).items():
                    tree[str(pid)] = start
                for pid in list(tree):
                    live = table.get(int(pid))
                    if live and live[1] != tree[pid]:
                        del tree[pid]          # recycled pid — a stranger now
        # Ledger-vs-world is only half the job: anything that escaped the
        # ledger (daemon crash mid-boot, corrupt ledger, detached children of
        # past suites) is invisible to the loop above and immortal without this.
        self._sweep_world(apply=True)

    def _dead(self, l, now):
        return bool(self._dead_reason(l, now))

    def _dead_reason(self, l, now):
        if l.get("owner_pid") is not None and not _owner_alive(l["owner_pid"], l.get("owner_start")):
            return f"owner pid {l['owner_pid']} gone"
        # A lease for a directory that no longer exists can never be useful
        # again: deleted worktrees were the main source of immortal Metro
        # leases, since a daemon-spawned Metro has no owner to outlive and the
        # TTL is measured in days. Only a *confirmed* absence counts — a parent
        # that is itself missing means an unmounted volume or similar, which is
        # not evidence the project is gone.
        cwd = l.get("cwd")
        if cwd and not os.path.isdir(cwd) and os.path.isdir(os.path.dirname(cwd)):
            return f"working dir {cwd} no longer exists"
        exp = l.get("expires")
        if exp is not None and exp < now:
            # TTL is a backstop for callers the daemon can't track (no owner)
            # and for reserved blocks (documented: reserved leases reap on TTL
            # even with a live owner). A BOOTED lease whose tracked owner is
            # verifiably alive is not orphaned — let owner-death/liveness
            # govern it instead of killing a healthy hour-old dev-env.
            if l["kind"] == "reserved" or l.get("owner_pid") is None:
                return "ttl expired"
        if l["kind"] == "reserved":
            # Daemon-spawned process (--spawn): its pid IS the lease's liveness —
            # ports are irrelevant (Metro restarting/compiling must not reap it).
            if l.get("pid"):
                if not _child_alive(l["pid"]):
                    return f"spawned pid {l['pid']} died"
                return None
            # Caller boots its own — liveness on the block.
            base = l["block"]
            if _port_open(base) or _port_open(base + 1):
                l["seen_active"], l["down_since"] = True, None
            elif l.get("seen_active"):
                l["down_since"] = l.get("down_since") or now
            grace = OWNED_RECLAIM_GRACE if l.get("owner_pid") is not None else RECLAIM_GRACE
            if l.get("down_since") and now - l["down_since"] >= grace:
                return "reserved block down past grace"
            return None
        if l.get("state") == "booting":
            # Provisional record written at spawn time so a daemon crash can't
            # orphan a mid-boot suite. Ports aren't expected open yet — only a
            # dead process or a blown boot window reaps it. No pid yet = the
            # block is drawn and the spawn is about to happen (outside the lock).
            if not l.get("pid"):
                if now - l.get("booting_since", now) > BOOT_BACKSTOP + 60:
                    return "boot window exceeded"
                return None
            if not _child_alive(l.get("pid")):
                return f"suite pid {l.get('pid')} died during boot"
            if now - l.get("booting_since", now) > BOOT_BACKSTOP + 60:
                return "boot window exceeded"
            return None
        # Booted suite: the process is the strong liveness signal — reap a dead
        # process immediately. Ports are a weak signal (a single 0.5s connect can
        # fail on a loaded machine while the suite is fine), so closed ports only
        # reap after RECLAIM_GRACE of CONTINUOUS downtime, mirroring the
        # reserved-lease path above.
        if not _child_alive(l.get("pid")):
            return f"suite pid {l.get('pid')} died"
        if _all_open(l.get("check_ports") or _service_ports(l["ports"])):
            l["down_since"] = None
            return None
        l["down_since"] = l.get("down_since") or now
        if now - l["down_since"] >= RECLAIM_GRACE:
            return "ports down past grace"
        return None

    def _free_block(self):
        used = {l["block"] for l in self._held() if l.get("block")}
        published = _docker_published_ports()
        for i in range(POOL_BLOCKS):
            base = POOL_BASE + i * BLOCK
            if base in used:
                continue
            if any(base + off in published for off in range(BLOCK)):
                continue
            if all(not _port_open(base + off) for off in range(BLOCK)):
                return base
        raise RuntimeError("emulator port pool exhausted")

    def _free_android_console(self):
        """An even console port in ANDROID_CONSOLE_FIRST..LAST whose pair
        (console, console + 1 = adb) no live lease holds and nothing listens
        on. Called under self.lock, so two callers never draw one pair; the
        listen check keeps a hand-booted emulator's pair out of it."""
        used = {l["ports"].get("android_console") for l in self._held()
                if isinstance(l.get("ports"), dict)}
        first = ANDROID_CONSOLE_FIRST + (ANDROID_CONSOLE_FIRST % 2)   # consoles are even
        for console in range(first, ANDROID_CONSOLE_LAST + 1, 2):
            if console in used:
                continue
            if not _port_open(console) and not _port_open(console + 1):
                return console
        raise RuntimeError(f"android console pool exhausted ({first}-{ANDROID_CONSOLE_LAST}: "
                           f"every pair is leased or listening)")

    def _lease_android(self, ports):
        console = self._free_android_console()
        ports["android_console"], ports["android_adb"] = console, console + 1

    def _boot(self, cwd, block, only, project_id, label, on_spawn=None, extra_env=None):
        all_ports = _block_ports(block)
        tmp = _write_injected_config(cwd, all_ports, only)
        # Readiness/liveness track ONLY the data services actually started (respect
        # --only, else the project's declared emulators; skip ui/hub/logging) — else
        # we'd wait forever for ports (functions, pubsub, …) that never open.
        declared = [k for k in json.loads((Path(cwd) / "firebase.json").read_text()).get("emulators", {}) if k != "singleProjectMode"]
        run_ports = {s: all_ports[s] for s in (only or declared) if s in all_ports}
        # Not waited on: the ones the CLI starts on its own terms (eventarc and
        # tasks only for a functions backend), and hosting with no hosting
        # config, which the CLI skips with a warning.
        has_hosting = "hosting" in json.loads((Path(cwd) / tmp).read_text())
        check = {s: p for s, p in run_ports.items()
                 if s not in IMPLICIT_EMULATORS and (s != "hosting" or has_hosting)}
        log = STATE_DIR / f"{label}.log"
        # Each suite gets its OWN temp dir. firebase-tools keeps the Storage
        # emulator's blobs at `${os.tmpdir()}/firebase/storage/blobs` — one
        # fixed path for every instance on the box — and `stop()` rm -rf's it.
        # So any suite shutting down wiped the blobs of every other suite still
        # running, and their next upload died with ENOENT inside firebase-tools
        # ("An unexpected error has occurred.", exit 2, all emulators gone).
        # On a box that runs several suites at once that is not a corner case:
        # 2026-08-28, three walk2gether e2e runs in a row on the studio, each
        # killed by a daemon verify drive finishing. os.tmpdir() honours
        # TMPDIR, so a per-suite one makes the path private.
        suite_tmp = _suite_tmpdir(label)
        suite_tmp.mkdir(parents=True, exist_ok=True)
        cmd = ["firebase", "emulators:start", "--config", tmp]
        if only:
            cmd += ["--only", ",".join(only)]
        if project_id:
            cmd += ["--project", project_id]
        # Caller-supplied env (acquire --fn-env KEY=VAL) rides on top of the
        # daemon's env — the functions emulator runtime inherits it, which is
        # the only way a CALLER can set per-suite env (e.g. LLM_CACHE_DIR)
        # when the daemon, not the caller, spawns the emulator.
        spawn_env = {**os.environ, **_with_ports(project_env(cwd), all_ports), "TMPDIR": str(suite_tmp)}
        if extra_env:
            spawn_env.update(_with_ports({str(k): str(v) for k, v in dict(extra_env).items()}, all_ports))
        with open(log, "w") as lf:
            proc = subprocess.Popen(cmd, cwd=cwd, stdout=lf, stderr=subprocess.STDOUT, start_new_session=True, env=spawn_env)
        if on_spawn:
            # Register the suite BEFORE the (up to 600s) readiness wait: a
            # daemon crash inside this window used to leave a fully-booted,
            # session-detached, ledger-less suite that nothing could ever find.
            on_spawn(proc.pid, tmp, str(log))
        # Liveness-driven: keep waiting while the process is alive (a slow JVM is still
        # booting, not stuck); succeed when the ports open; fail if it exits; the
        # backstop only guards a genuinely wedged boot.
        backstop = time.time() + BOOT_BACKSTOP
        while True:
            if _all_open(check):
                return proc.pid, tmp, str(log), run_ports, check
            if proc.poll() is not None:
                raise RuntimeError(f"emulators exited early; see {log}\n{_tail(log)}")
            if time.time() > backstop:
                try:
                    os.killpg(os.getpgid(proc.pid), signal.SIGKILL)   # killpg → reap JVM children
                except (OSError, ProcessLookupError):
                    pass
                raise RuntimeError(f"boot backstop ({BOOT_BACKSTOP}s) hit, process still alive; see {log}")
            time.sleep(1)

    def _cleanup(self, rec):
        """Teardown frees the lease's RESOURCES — process group, ports, sim —
        and verifies, loudly. Killing only the process we spawned is not
        enough: firebase-tools detaches its JVMs and functions workers into
        their own groups (killpg can't reach them), and the caller's Metro on
        the leased port was never ours at all. The port block IS the lease, so
        after the group kill anything still LISTENing on the block dies too,
        and the block is re-checked before we forget the lease. Never pkill —
        every kill here is by recorded pid or by a port the lease owns."""
        lid = rec.get("leaseId") or "?"
        actions = []
        pid = rec.get("pid")
        # PID-reuse guard (same contract as owners): if the pid's start time no
        # longer matches what we recorded at spawn, it's a recycled pid — do
        # not signal a stranger. Old ledger records lack pid_start; for those
        # the group kill proceeds as before.
        recorded_start = rec.get("pid_start")
        if pid and recorded_start:
            observed = _proc_start(pid)
            if observed and observed != recorded_start:
                actions.append(f"pid {pid} recycled — not signalled")
                pid = None
        pgid = rec.get("pgid")
        if pgid is None and pid and _pid_alive(pid):
            try:
                pgid = os.getpgid(int(pid))
            except (OSError, ProcessLookupError):
                pgid = None
        def reap_zombie():
            # Our exited child lingers as a zombie until waited on — and a
            # zombie still counts as a group member, so _group_alive would
            # read "survived" forever without this.
            if pid:
                try:
                    os.waitpid(int(pid), os.WNOHANG)
                except (ChildProcessError, OSError, ValueError):
                    pass

        if pgid and int(pgid) > 1:
            # Escalation waits on the GROUP, not the parent: the old loop broke
            # the moment node exited on SIGTERM, so SIGKILL never reached slow
            # or stubborn group members.
            for sig in (signal.SIGTERM, signal.SIGKILL):
                reap_zombie()
                if not _group_alive(pgid):
                    break
                try:
                    os.killpg(int(pgid), sig)
                except (OSError, ProcessLookupError):
                    break
                for _ in range(50):
                    reap_zombie()
                    if not _group_alive(pgid):
                        break
                    time.sleep(0.1)
            reap_zombie()
            actions.append(f"group {pgid} " +
                           ("SURVIVED kill" if _group_alive(pgid) else "killed"))
        else:
            reap_zombie()
        # The recorded tree: children observed under the root while it lived,
        # including the setsid'd workers the group kill above can never reach
        # and non-listening processes the port sweep below can never see —
        # functionsEmulatorRuntime leaked two per run through exactly that gap.
        # Start-time is re-checked at kill time: a recycled pid is a stranger.
        tree = rec.get("tree") or {}
        strays = set()
        for pid, start in tree.items():
            pid = int(pid)
            observed = _proc_start(pid)
            if observed and observed == start:
                strays.add(pid)
        strays.discard(rec.get("pid"))
        if strays:
            killed = _kill_wave(strays)
            if killed:
                actions.append(f"tree sweep killed {sorted(killed)}")
        # Port sweep: every port the lease covers. rec["ports"] catches legacy
        # records; the block range catches everything else (metro, websocket).
        android = {v for k, v in (rec.get("ports") or {}).items()
                   if k in ("android_console", "android_adb") and isinstance(v, int)}
        ports = {v for v in (rec.get("ports") or {}).values() if isinstance(v, int)} - android
        if rec.get("block"):
            ports |= {rec["block"] + off for off in range(BLOCK)}
        if ports:
            listening = _listeners()
            squatters = {p for port in ports for p in listening.get(port, ())}
            killed = _kill_wave(squatters)
            if killed:
                actions.append(f"port sweep killed {killed}")
            still = sorted(port for port, pids in _listeners().items()
                           if port in ports and pids)
            if still:
                actions.append(f"ports STILL HELD after sweep: {still}")
        # The Android pair is OUTSIDE the pool, where a hand-booted emulator
        # lands by default (5554). So it is not port-swept: what the lease
        # spawned died with its group and recorded tree above; anything still
        # on the pair is reported, never signalled (the world sweep evicts it
        # only if it is provably ours).
        if android:
            held = {port: pids for port, pids in _listeners().items() if port in android and pids}
            if held:
                actions.append(f"android ports still held (not signalled): "
                               + ", ".join(f"{p} by {sorted(v)}" for p, v in sorted(held.items())))
        tmp = rec.get("tmp_config")
        if tmp and rec.get("cwd") and (Path(rec["cwd"]) / tmp).exists():
            (Path(rec["cwd"]) / tmp).unlink()
        # The suite's private TMPDIR (see _boot). Derived from the label the
        # same way _boot derived it, so old ledger records need no new field.
        label = rec.get("label") or (Path(rec["log"]).stem if rec.get("log") else None)
        if label:
            shutil.rmtree(_suite_tmpdir(label), ignore_errors=True)
        if rec.get("sim_udid"):
            gone = _sim_teardown(rec["sim_udid"])
            actions.append(f"sim {rec['sim_udid'][:8]} " +
                           ("deleted" if gone else "DELETE FAILED (sweep will retry)"))
        if actions:
            print(f"teardown {lid}: " + "; ".join(actions), flush=True)

    def _commit(self, lid, rec, client_gone, undo):
        """Under self.lock: grant `lid` as `rec`, unless the lease was reaped
        while its resources were made outside the lock (owner died mid-boot)
        or the caller hung up waiting (its client-side timeout fired). A grant
        nobody receives is a block reserved for its whole TTL with no one to
        release it — the 2026-10-22 studio orphans. Either way `undo` (the
        record to tear down) is retired and the caller raises."""
        if lid not in self.leases:
            self.draining[lid] = undo
            return f"lease {lid} was reaped while it was being made"
        if client_gone and client_gone():
            self._retire(lid, f"not granting {lid}: the client gave up waiting")
            self.draining[lid] = undo
            return f"client gave up before {lid} was granted"
        self.leases[lid] = rec
        self._save()
        return None

    def acquire(self, cwd, owner_pid, owner_start=None, only=None, ttl=DEFAULT_TTL,
                metro=False, sim=False, sim_device=None, sim_runtime=None, env=None,
                android=False, client_gone=None):
        # The lock covers DRAWING the block (and the Android pair) and writing
        # the provisional record that holds them; the boot (up to
        # BOOT_BACKSTOP) and the simulator happen outside it, so one suite's
        # boot never queues every other caller.
        lid = f"run:{uuid.uuid4().hex[:12]}"
        project_id = _firebaserc_project(cwd)
        with self.lock:
            base = self._free_block()
            # Drawn before the boot, so an exhausted range costs no suite.
            android_console = self._free_android_console() if android else None
            self.leases[lid] = {"leaseId": lid, "kind": "acquired",
                                "state": "booting", "booting_since": time.time(),
                                "cwd": cwd, "block": base,
                                "ports": ({"android_console": android_console,
                                           "android_adb": android_console + 1}
                                          if android_console else {}),
                                "pid": None, "owner_pid": owner_pid, "owner_start": owner_start,
                                "project_id": project_id,
                                "started": _now(), "expires": time.time() + ttl}
            self._save()

        def on_spawn(spawn_pid, spawn_tmp, spawn_log):
            # Provisional record, saved before the readiness wait: a daemon
            # crash mid-boot must leave a findable lease, not a ghost suite.
            with self.lock:
                l = self.leases.get(lid)
                if l is None:
                    # Reaped between the draw and the spawn (owner died).
                    try:
                        os.killpg(spawn_pid, signal.SIGKILL)
                    except (OSError, ProcessLookupError):
                        pass
                    raise RuntimeError(f"lease {lid} was reaped while it booted")
                l.update({"pid": spawn_pid, "pgid": spawn_pid,
                          "pid_start": _proc_start(spawn_pid),
                          "tmp_config": spawn_tmp, "log": spawn_log})
                self._save()

        try:
            pid, tmp, log, ports, check = self._boot(
                cwd, base, only, project_id, lid.replace(":", "-"), on_spawn,
                extra_env=env)
        except Exception:
            with self.lock:
                rec = self._retire(lid, f"boot of {lid} failed")
            self._drain([rec])
            raise
        # A leased simulator implies a metro port (the e2e dev-env wants both).
        # The metro port lives in the lease's own 20-port block, so it's
        # collision-free by construction and needs no health check.
        if metro or sim:
            ports["metro"] = base + METRO_OFFSET
        if android_console:
            ports["android_console"], ports["android_adb"] = android_console, android_console + 1
        sim_udid = sim_name = None
        if sim:
            sim_name = lid.replace(":", "-")
            with self.lock:
                l = self.leases.get(lid)
                if l is not None:
                    # The sim phase gets its own window, and its name, so the
                    # world sweep knows the device it is about to see is ours.
                    l["booting_since"], l["sim_name"] = time.time(), sim_name
            try:
                sim_udid = _sim_create_boot(sim_device or DEFAULT_SIM_DEVICE,
                                            sim_runtime or DEFAULT_SIM_RUNTIME, sim_name)
            except Exception:
                # Don't leak the emulators we just booted if the sim fails.
                with self.lock:
                    rec = self._retire(lid, f"sim for {lid} failed")
                self._drain([rec])
                raise
        rec = {"leaseId": lid, "kind": "acquired", "cwd": cwd, "block": base,
               "ports": ports, "check_ports": check, "pid": pid,
               "pgid": pid, "pid_start": _proc_start(pid),
               "owner_pid": owner_pid, "owner_start": owner_start,
               "tmp_config": tmp, "log": log, "project_id": project_id,
               "sim_udid": sim_udid, "sim_name": sim_name,
               "started": _now(), "expires": time.time() + ttl}
        with self.lock:
            tree = (self.leases.get(lid) or {}).get("tree")
            if tree:
                rec["tree"] = tree
            refused = self._commit(lid, rec, client_gone, rec)
        if refused:
            self._drain([rec])
            raise RuntimeError(refused)
        resp = {"leaseId": lid, "ports": ports, "projectId": project_id}
        if sim_udid:
            resp["sim"] = {"udid": sim_udid, "name": sim_name}
        return resp

    def allocate(self, owner_pid, owner_start=None, ttl=DEFAULT_TTL, label=None,
                 metro=False, sim=False, sim_device=None, sim_runtime=None,
                 spawn=None, spawn_cwd=None, android=False, client_gone=None):
        lid = f"alloc:{uuid.uuid4().hex[:12]}"
        sim_name = lid.replace(":", "-") if sim else None
        with self.lock:
            base = self._free_block()
            ports = {"base": base}
            # A reserved block can also carry the dev-env extras for callers that
            # boot their own emulators (or none at all): a Metro port and/or a
            # private simulator. Used by e2e Metro sessions whose emulator suites
            # are per-RUN acquires (walk2gether) — the long-lived Metro process
            # owns just the port + sim.
            if metro or sim:
                ports["metro"] = base + METRO_OFFSET
            # --android: an emulator console/adb pair, outside the pool (adb
            # only discovers 5554..5584) but leased the same way.
            if android:
                self._lease_android(ports)
            rec = {"leaseId": lid, "kind": "reserved", "cwd": spawn_cwd,
                   "block": base, "ports": ports, "pid": None,
                   "pgid": None, "pid_start": None,
                   "owner_pid": owner_pid,
                   "owner_start": owner_start, "tmp_config": None,
                   "log": None, "spawn": spawn,
                   "label": label, "sim_udid": None, "sim_name": sim_name,
                   "started": _now(), "expires": time.time() + ttl}
            if not sim and not spawn:
                # Nothing slow to make: grant it here — unless the caller hung
                # up while it waited for the lock.
                if client_gone and client_gone():
                    print(f"not granting {lid} ({label or 'no label'}): the client gave up waiting", flush=True)
                    raise RuntimeError("client gave up before the lease was granted")
                self.leases[lid] = rec
                self._save()
                print(f"leased {lid} ({label or 'no label'}): base {base}"
                      f"{' android ' + str(ports['android_console']) if android else ''}", flush=True)
                return {"leaseId": lid, "base": base, "ports": ports}
            # Hold the block (and the sim's name) while the slow part runs
            # outside the lock: the reaper reads a reserved lease with no pid
            # and a closed block as live until its owner or TTL says otherwise.
            self.leases[lid] = dict(rec)
            self._save()
        sim_udid = None
        try:
            if sim:
                sim_udid = _sim_create_boot(sim_device or DEFAULT_SIM_DEVICE,
                                            sim_runtime or DEFAULT_SIM_RUNTIME, sim_name)
                rec["sim_udid"] = sim_udid
            # --spawn: the DAEMON runs the lease's process (Metro, a dev server…),
            # so it survives the calling shell/agent/session. Its pid is the
            # lease's liveness; teardown killpgs it like a booted suite.
            pid = None
            log = None
            if spawn:
                log = str(STATE_DIR / f"{lid.replace(':', '-')}.log")
                env = {**os.environ,
                       "FBPORTS_BLOCK_BASE": str(base),
                       "FBPORTS_LEASE_ID": lid}
                if ports.get("metro"):
                    env["METRO_PORT"] = str(ports["metro"])
                if ports.get("android_console"):
                    env.update(_android_env(ports))
                if sim_udid:
                    env["DETOX_UDID"] = sim_udid
                    env["DETOX_SIM_NAME"] = sim_name
                with open(log, "w") as lf:
                    proc = subprocess.Popen(["/bin/sh", "-c", spawn],
                                            cwd=spawn_cwd or None, env=env,
                                            stdout=lf, stderr=subprocess.STDOUT,
                                            start_new_session=True)
                pid = proc.pid
                rec.update({"pid": pid, "pgid": pid, "pid_start": _proc_start(pid), "log": log})
        except Exception:
            # Don't leak the simulator we just created if the spawn fails.
            with self.lock:
                self.leases.pop(lid, None)
                self.draining[lid] = rec
            self._drain([rec])
            raise
        with self.lock:
            refused = self._commit(lid, rec, client_gone, rec)
        if refused:
            self._drain([rec])
            raise RuntimeError(refused)
        android_note = f" android {ports['android_console']}" if android else ""
        print(f"leased {lid} ({label or 'no label'}): base {base}"
              f"{f' sim {sim_name}' if sim_udid else ''}{android_note}"
              f"{f' spawned pid {pid}' if pid else ''}", flush=True)
        resp = {"leaseId": lid, "base": base, "ports": ports}
        if sim_udid:
            resp["sim"] = {"udid": sim_udid, "name": sim_name}
        if pid:
            resp["spawnedPid"] = pid
            resp["log"] = log
        return resp

    def release(self, lid):
        with self.lock:
            rec = self.leases.get(lid)
            if not rec:
                return {"released": False, "reason": "unknown lease"}
            self._retire(lid, f"released {lid} ({rec.get('label') or rec.get('cwd') or 'no label'})")
            self._save()
        self._drain([rec])
        return {"released": True}

    def release_owned(self, owner_pid, cwd=None):
        with self.lock:
            recs = []
            for lid in list(self.leases):
                l = self.leases[lid]
                if l.get("owner_pid") == owner_pid and (cwd is None or l.get("cwd") == cwd):
                    recs.append(self._retire(lid, f"released {lid} (owner {owner_pid} asked)"))
            self._save()
        self._drain(recs)
        return {"released": len(recs)}

    def reown(self, lid, owner_pid, owner_start=None):
        """Hand a lease to another owner. A daemon leases a run's block before it
        spawns the run, so the daemon is the owner; a run that outlives its daemon
        (adopted by the next one after a fleet restart) lost its block the moment
        the old daemon exited, and the port sweep killed its emulators mid-scene
        (simon-says run eTNE06AK34IJcoKGyj0k, 2026-10-22). The run takes its block
        over at startup, so the block lives exactly as long as the run."""
        with self.lock:
            l = self.leases.get(lid)
            if not l:
                return {"ok": False, "reason": "no such lease"}
            if owner_pid is None or not _pid_alive(int(owner_pid)):
                return {"ok": False, "reason": f"owner {owner_pid} is not alive"}
            l["owner_pid"] = int(owner_pid)
            l["owner_start"] = owner_start if owner_start is not None else _proc_start(int(owner_pid))
            self._save()
            return {"ok": True}

    def heartbeat(self, lid, ttl=DEFAULT_TTL):
        with self.lock:
            l = self.leases.get(lid)
            if l and l.get("expires") is not None:
                l["expires"] = time.time() + ttl
                self._save()
            return {"ok": bool(l)}

    def status(self):
        with self.lock:
            return {"leases": [{"leaseId": l["leaseId"], "kind": l["kind"], "cwd": l.get("cwd"),
                                "ownerPid": l.get("owner_pid"), "up": _pid_alive(l.get("pid")),
                                "ports": l["ports"], "projectId": l.get("project_id"),
                                "sim": l.get("sim_udid"), "expires": l.get("expires"),
                                "label": l.get("label"), "log": l.get("log")}
                               for l in self.leases.values()],
                    # Torn down right now, outside the lock; their blocks
                    # return to the pool when it finishes.
                    "draining": sorted(self.draining),
                    # What the idle-simulator sweep last saw and did (SSB's Hosts
                    # card reads it: a leak is a number, not a chart to diagnose).
                    "idleSims": getattr(self, "_idle_sims", None),
                    "companions": getattr(self, "_companions", None)}

    def reap(self):
        now = time.time()
        with self.lock:
            # Under the lock only the verdict and the bookkeeping; every
            # teardown runs after it is released (_drain).
            retired = []
            for lid in list(self.leases):
                reason = self._dead_reason(self.leases[lid], now)
                if reason:
                    # The routine reap path used to be silent — weeks of leaked
                    # JVMs left zero trace. Every reap states its reason.
                    retired.append(self._retire(lid, f"reaping {lid}: {reason}"))
            self._save()
        self._drain(retired)
        # Runs on the tick, not just at startup: the tree must be observed
        # WHILE the parents live — after a root dies its detached children
        # read ppid 1 and can never be attributed again.
        self._record_trees()
        self._drain(self._reap_deleted_sims(now))
        with self.lock:
            self._save()
        if now - getattr(self, "_swept", 0) >= SWEEP_INTERVAL:
            self._swept = now
            self._sweep_world(apply=True)

    def _reap_deleted_sims(self, now):
        """Reap leases whose simulator was deleted externally (Xcode cleanup,
        `simctl delete/erase`, a stray reset). The lease is broken for its
        caller even though its process is healthy; reaping it WHOLE (killing
        the spawn too) prevents the half-alive ghost: sim gone, Metro still
        squatting its port, callers 'reusing' a session Detox can't drive.
        Throttled — one simctl listing per SIM_CHECK_INTERVAL, not per lease.
        Returns the retired records; the caller drains them outside the lock."""
        if now - getattr(self, "_sims_checked", 0) < SIM_CHECK_INTERVAL:
            return []
        with self.lock:
            sim_leases = {lid: l["sim_udid"] for lid, l in self.leases.items() if l.get("sim_udid")}
        if not sim_leases:
            self._sims_checked = now
            return []
        udids = _sim_udids()                    # simctl, outside the lock
        if udids is None:
            return []                           # indeterminate — no evidence, retry next pass
        self._sims_checked = now
        retired = []
        with self.lock:
            for lid, udid in sim_leases.items():
                l = self.leases.get(lid)
                if l and l.get("sim_udid") == udid and udid not in udids:
                    retired.append(self._retire(lid, f"reaping {lid}: sim {udid} deleted externally"))
        return retired

    def verify(self, lid):
        """Full-liveness check for one lease, for callers deciding whether to
        REUSE a session rather than re-lease: known to the daemon + process
        alive + simulator present + (booted suites) ports open. Read-only —
        never tears anything down."""
        with self.lock:
            l = self.leases.get(lid)
            if not l:
                return {"ok": False, "reasons": ["unknown lease"]}
            l = dict(l)                         # probed outside the lock (simctl)
        reasons = []
        pid = l.get("pid")
        if pid and not _child_alive(pid):
            reasons.append(f"process {pid} dead")
        if l.get("sim_udid"):
            udids = _sim_udids()
            if udids is not None and l["sim_udid"] not in udids:
                reasons.append(f"sim {l['sim_udid']} gone")
        if l["kind"] == "acquired":
            down = [s for s, p in (l.get("check_ports") or _service_ports(l["ports"])).items()
                    if not _port_open(p)]
            if down:
                reasons.append("ports down: " + ",".join(sorted(down)))
        return {"ok": not reasons, "reasons": reasons}

    def _sweep_world(self, apply):
        """The other half of reconciliation: find resources that exist in the
        WORLD but not in the ledger, and (apply=True) evict them. Three classes,
        each one an observed leak:

        - listeners on pool ports no lease covers (caller-run Metros, suites
          that outlived a lost ledger entry);
        - firebase-tools runtimes re-parented to pid 1 (detached JVMs and
          functions workers whose suite died — killpg can never reach these);
        - harbormaster-named simulators (run-*/alloc-*) with no lease.

        Finding and killing are separate verdicts. Everything above is worth
        REPORTING (a squatted block can't be leased; an orphaned JVM is a leak
        whoever fathered it), but eviction requires positive attribution: the
        pid appears in a live lease's recorded tree (start-time re-checked),
        the cmdline names the .firebase.brokered-* config only harbormaster
        writes, or the sim's UDID is in this daemon's authored-sims registry.
        "Looks like it might have come from us" is not attribution — the
        lease-shape rule killed ollama, and name-matching run-* sims had two
        daemons on one box deleting each other's devices.
        Returns findings for `doctor`."""
        findings = []
        # Snapshot under the lock; scan (lsof, ps, simctl) and act outside it.
        # Every eviction is re-checked against the ledger as it stands just
        # before the kill (below), so a lease granted mid-scan is never swept.
        with self.lock:
            held = self._held_sets()
        lease_pids = held["pids"]
        # The authorship ledger: every (pid, start) any held lease's tree has
        # recorded. Eviction requires membership here — start re-checked so a
        # recycled pid never matches — or a cmdline that names the injected
        # config file only harbormaster writes. Anything else is somebody
        # else's process wearing a familiar name: reported, never signalled.
        authored = held["authored"]

        def _attributed(pid, cmdline=""):
            if ".firebase.brokered-" in cmdline:
                return True
            start = authored.get(pid)
            return bool(start) and _proc_start(pid) == start

        leased_ports = held["ports"]
        pool_end = POOL_BASE + POOL_BLOCKS * BLOCK
        for port, pids in _listeners().items():
            in_android = ANDROID_CONSOLE_FIRST <= port <= ANDROID_CONSOLE_LAST + 1
            if (POOL_BASE <= port < pool_end or in_android) and port not in leased_ports:
                for pid in pids:
                    if pid not in lease_pids:
                        cmd = _proc_field(pid, "command=")[:200]
                        findings.append({"kind": "listener", "pid": pid, "port": port,
                                         "cmd": cmd, "evict": _attributed(pid, cmd)})
        try:
            r = subprocess.run(["ps", "-xo", "pid=,ppid=,command="],
                               capture_output=True, text=True, timeout=10)
            for line in r.stdout.splitlines():
                parts = line.split(None, 2)
                if len(parts) < 3 or parts[1] != "1":
                    continue
                pid, cmdline = int(parts[0]), parts[2]
                if pid in lease_pids or pid == os.getpid():
                    continue
                if (any(sig in cmdline for sig in SWEEP_SIGNATURES)
                        or ".firebase.brokered-" in cmdline):
                    findings.append({"kind": "orphan", "pid": pid,
                                     "cmd": cmdline[:200],
                                     "evict": _attributed(pid, cmdline)})
        except (subprocess.SubprocessError, OSError, ValueError):
            pass
        inv = _sim_inventory()
        if inv is not None:
            leased_udids = held["udids"]
            mine = _authored_sims()
            for udid, name in inv.items():
                if ((name.startswith("run-") or name.startswith("alloc-"))
                        and udid not in leased_udids and name not in held["names"]):
                    findings.append({"kind": "sim", "udid": udid, "name": name,
                                     "evict": udid in mine})
        if apply:
            self._sweep_idle_sims(inv, held["udids"])
            self._sweep_companions(inv)
        if apply and findings:
            with self.lock:
                now_held = self._held_sets()
            for f in findings:
                if not f.get("evict"):
                    continue
                if f["kind"] == "sim":
                    claimed = f["udid"] in now_held["udids"] or f["name"] in now_held["names"]
                else:
                    claimed = (f["pid"] in now_held["pids"]
                               or f.get("port") in now_held["ports"])
                if claimed:
                    f["evict"] = False           # leased since the scan began
            pids = {f["pid"] for f in findings
                    if f["kind"] in ("listener", "orphan") and f.get("evict")}
            if pids:
                killed = _kill_wave(pids)
                print(f"world sweep killed {killed}", flush=True)
            for f in findings:
                if f["kind"] == "sim" and f.get("evict"):
                    gone = _sim_teardown(f["udid"])
                    print(f"world sweep sim {f['name']} ({f['udid'][:8]}): "
                          + ("deleted" if gone else "DELETE FAILED"), flush=True)
                elif f["kind"] == "sim":
                    seen = self.__dict__.setdefault("_bystanders_logged", set())
                    if f["udid"] not in seen:
                        seen.add(f["udid"])
                        print(f"world sweep sim {f['name']} ({f['udid'][:8]}) left "
                              f"alone (not provably ours — another daemon's?)",
                              flush=True)
                elif not f.get("evict"):
                    # Logged once per pid — an unattributed finding survives
                    # every sweep by design, and 288 identical lines a day is
                    # how logs go unread.
                    seen = self.__dict__.setdefault("_bystanders_logged", set())
                    if f["pid"] not in seen:
                        seen.add(f["pid"])
                        where = f" on port {f['port']}" if f.get("port") else ""
                        print(f"world sweep {f['kind']}{where} left alone "
                              f"(not provably ours): pid {f['pid']} — {f['cmd']}",
                              flush=True)
                else:
                    print(f"world sweep {f['kind']}: pid {f['pid']}"
                          + (f" port {f['port']}" if f.get("port") else "")
                          + f" — {f['cmd']}", flush=True)
        return findings

    def _sweep_idle_sims(self, inv, leased_udids):
        """Shut down booted simulators no lease holds that have sat idle past
        IDLE_SIM_HOURS. Shutdown only — the device and its data stay, and its
        owner boots it again. Recorded for status whatever it finds."""
        if not IDLE_SIM_HOURS or IDLE_SIM_HOURS <= 0:
            return
        try:
            r = subprocess.run(["ps", "-axo", "etime=,command="], capture_output=True, text=True, timeout=10)
        except (subprocess.SubprocessError, OSError):
            return
        booted = _booted_sims(r.stdout)
        leased = {str(u).upper() for u in leased_udids}
        names = {u.upper(): n for u, n in (inv or {}).items()}
        idle = idle_unleased_sims(booted, leased, names)
        done = []
        for s in idle:
            try:
                subprocess.run(["xcrun", "simctl", "shutdown", s["udid"]], capture_output=True, text=True, timeout=60)
                done.append(s)
                print(f"idle sim {s['name'] or '?'} ({s['udid'][:8]}) shut down: no lease, "
                      f"booted {s['upH']}h, no app running", flush=True)
            except (subprocess.SubprocessError, OSError) as e:
                print(f"idle sim {s['udid'][:8]}: shutdown failed: {e}", flush=True)
        unleased = [u for u in booted if u not in leased]
        prev = getattr(self, "_idle_sims", None) or {}
        self._idle_sims = {"at": time.time(), "booted": len(booted), "unleased": len(unleased),
                           "afterHours": IDLE_SIM_HOURS,
                           "shutDown": (done + (prev.get("shutDown") or []))[:20]}

    def _sweep_companions(self, inv):
        """End idb companions whose simulator is gone and remove their sockets.
        Skipped when the inventory is indeterminate: an empty or failed
        `simctl list` must never read as "every device is gone"."""
        if not inv:
            return
        try:
            r = subprocess.run(["ps", "-xo", "pid=,etime=,command="], capture_output=True, text=True, timeout=10)
        except (subprocess.SubprocessError, OSError):
            return
        comps = _companions(r.stdout)
        dead = dead_companions(comps, {u.upper() for u in inv})
        if dead:
            # Re-read: a device created since the first read keeps its companion.
            again = _sim_inventory()
            dead = dead_companions(dead, {u.upper() for u in again}) if again else []
        killed = sorted(_kill_wave({c["pid"] for c in dead})) if dead else []
        if killed:
            print(f"idb companions ended (device gone): {len(killed)} — "
                  + ", ".join(c["udid"][:8] for c in dead[:8]), flush=True)
        live = {c["udid"] for c in comps if c["pid"] not in set(killed)}
        removed = 0
        try:
            names = os.listdir(IDB_SOCK_DIR)
        except OSError:
            names = []
        now = time.time()
        for n in stale_companion_sockets(names, {u.upper() for u in inv}, live):
            path = os.path.join(IDB_SOCK_DIR, n)
            try:
                if now - os.lstat(path).st_mtime >= COMPANION_GRACE_S:
                    os.unlink(path)
                    removed += 1
            except OSError:
                pass
        if removed:
            print(f"idb sockets removed (device gone): {removed}", flush=True)
        self._companions = {"at": now, "running": len(comps), "ended": len(killed),
                            "socketsRemoved": removed}

    def doctor(self, fix=False):
        """Report (and with fix=True, evict) everything the sweep can see —
        the command that would have made 51 orphaned JVMs visible on day one."""
        findings = self._sweep_world(apply=fix)
        return {"findings": findings, "fixed": bool(fix and findings),
                "leases": len(self.leases)}


class _Handler(http.server.BaseHTTPRequestHandler):
    broker = None

    def log_message(self, *_):
        pass

    def _send(self, code, obj):
        body = json.dumps(obj).encode()
        self.send_response(code)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def _body(self):
        n = int(self.headers.get("Content-Length") or 0)
        try:
            return json.loads(self.rfile.read(n) or b"{}") if n else {}
        except json.JSONDecodeError:
            return {}

    def _client_gone(self):
        """True once the caller has closed its end: it gave up waiting (its
        own timeout fired) and will never read the answer. A request body is
        fully read before we get here, so a readable socket that peeks empty
        is the FIN — not a second request."""
        try:
            r, _, _ = select.select([self.connection], [], [], 0)
            if not r:
                return False
            return self.connection.recv(1, socket.MSG_PEEK) == b""
        except (OSError, ValueError):
            return True

    def do_GET(self):
        if self.path == "/health":
            return self._send(200, {"ok": True, "version": VERSION})
        if self.path == "/status":
            return self._send(200, self.broker.status())
        self._send(404, {"error": "not found"})

    def do_POST(self):
        b, d = self.broker, self._body()
        try:
            if self.path == "/acquire":
                return self._send(200, b.acquire(d["cwd"], d.get("owner_pid"), d.get("owner_start"),
                                                 d.get("only"), d.get("ttl", DEFAULT_TTL),
                                                 d.get("metro", False), d.get("sim", False),
                                                 d.get("sim_device"), d.get("sim_runtime"),
                                                 d.get("env"), d.get("android", False),
                                                 client_gone=self._client_gone))
            if self.path == "/allocate":
                return self._send(200, b.allocate(d.get("owner_pid"), d.get("owner_start"),
                                                  d.get("ttl", DEFAULT_TTL), d.get("label"),
                                                  d.get("metro", False), d.get("sim", False),
                                                  d.get("sim_device"), d.get("sim_runtime"),
                                                  d.get("spawn"), d.get("spawn_cwd"),
                                                  d.get("android", False),
                                                  client_gone=self._client_gone))
            if self.path == "/release":
                return self._send(200, b.release(d.get("leaseId")))
            if self.path == "/release-owned":
                return self._send(200, b.release_owned(d.get("owner_pid"), d.get("cwd")))
            if self.path == "/reown":
                return self._send(200, b.reown(d.get("leaseId"), d.get("owner_pid"), d.get("owner_start")))
            if self.path == "/heartbeat":
                return self._send(200, b.heartbeat(d.get("leaseId"), d.get("ttl", DEFAULT_TTL)))
            if self.path == "/verify":
                return self._send(200, b.verify(d.get("leaseId")))
            if self.path == "/doctor":
                return self._send(200, b.doctor(d.get("fix", False)))
            if self.path == "/shutdown":
                threading.Thread(target=self.server.shutdown, daemon=True).start()
                return self._send(200, {"ok": True})
            self._send(404, {"error": "not found"})
        except Exception as e:
            self._send(500, {"error": str(e)})


# A MANAGED broker (0.11.0): one a service manager runs and keeps alive —
# `harbormaster serve --managed` under systemd or launchd. Its marker in the
# state dir is touched every minute; while it is fresh, clients never replace
# the broker and never spawn their own: the service manager owns its lifecycle
# and its upgrades. Without this, the broker belonged to whichever client
# happened to start it. On simon-linux-1 (2026-10-09) that was an SSB job's own
# checkout inside the runner's systemd unit, and before it a CI job, whose
# orphan cleanup killed the broker — and every emulator it ran for OTHER jobs —
# mid-suite. A stale marker means the service is gone: clients spawn as before.
MANAGED_MARK = STATE_DIR / "managed"
MANAGED_FRESH_S = 300


def _managed_recent():
    try:
        return time.time() - MANAGED_MARK.stat().st_mtime < MANAGED_FRESH_S
    except OSError:
        return False


def _touch_managed():
    try:
        MANAGED_MARK.write_text(json.dumps({"pid": os.getpid(), "version": VERSION, "exe": str(Path(__file__).resolve())}))
    except OSError:
        pass


def cmd_serve(managed=False):
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    # BIND FIRST. Broker() is not inert: it loads the ledger, reaps dead
    # leases (deleting their sims), and saves. Until 0.17.1 it ran before the
    # bind, so every client that raced to start a broker after a reboot did a
    # whole reconcile and ledger write and only THEN died on "Address already
    # in use" — beside the broker that won. On the studio (2026-10-23) the
    # losers' writes corrupted the ledger, the winner quarantined it, and its
    # world sweep deleted four sims that live runs had just leased. The port
    # is the broker's mutex: only its holder may touch the ledger, the managed
    # mark, or anything on the box. A request that arrives before Broker() is
    # ready waits in the listen backlog — nothing is served until
    # serve_forever.
    try:
        srv = http.server.ThreadingHTTPServer((BROKER_HOST, BROKER_PORT), _Handler)
    except OSError as e:
        print(f"harbormaster: {BROKER_HOST}:{BROKER_PORT} is taken ({e}) — another broker "
              f"is serving; this one exits without touching the ledger", flush=True)
        sys.exit(1)
    if managed:
        _touch_managed()

        def keep_marked():
            while True:
                time.sleep(60)
                _touch_managed()
        threading.Thread(target=keep_marked, daemon=True).start()
    dropped = _scrub_environ()
    if dropped:
        print(f"harbormaster: scrubbed inherited env before serving: {', '.join(dropped)}", flush=True)
    _Handler.broker = Broker()

    def reaper():
        while True:
            time.sleep(REAP_INTERVAL)
            try:
                _Handler.broker.reap()
            except Exception:
                pass

    threading.Thread(target=reaper, daemon=True).start()
    print(f"harbormaster {VERSION} daemon on http://{BROKER_HOST}:{BROKER_PORT} "
          f"(pool {POOL_BASE}-{POOL_BASE + POOL_BLOCKS * BLOCK - 1})", flush=True)
    srv.serve_forever()


# ---- client --------------------------------------------------------------

def _call(method, path, body=None, timeout=BOOT_BACKSTOP + 60):   # client must outlive server's boot
    conn = http.client.HTTPConnection(BROKER_HOST, BROKER_PORT, timeout=timeout)
    data = json.dumps(body).encode() if body is not None else None
    conn.request(method, path, body=data, headers={"Content-Type": "application/json"} if data else {})
    resp = conn.getresponse()
    out = json.loads(resp.read() or b"{}")
    conn.close()
    return resp.status, out


def _up():
    try:
        return _call("GET", "/health", timeout=1)[0] == 200
    except OSError:
        return False


def _daemon_version():
    """The running daemon's version, '0' for pre-0.3 daemons, None if not running."""
    try:
        st, out = _call("GET", "/health", timeout=1)
        return (out.get("version") or "0") if st == 200 else None
    except OSError:
        return None


# A PROJECT'S OWN SUITE ENV: <cwd>/harbormaster.env.
#
# --fn-env is per CALLER, so a setting every suite of a project needs (the
# credentials its emulator must run under, say) had to be repeated by every
# caller — session tests, e2e, agent runs — and the one that forgot ran
# against production. impulse-functions (2026-10-16): its BigQuery export
# extensions run under the Extensions emulator and stream to whatever project
# the ambient credentials can reach; only a test service account keeps that
# test-only. So the project names it once, in the repo:
#
#   # harbormaster.env, next to firebase.json
#   GOOGLE_APPLICATION_CREDENTIALS=./impulse-test-bq.json
#
# KEY=VALUE lines; blank lines and `#` comments skipped; a value starting
# with ./ or ../ is a path relative to the project, made absolute (the
# emulator's functions run in other directories). acquire: on top of the
# daemon's (scrubbed) env, UNDER the caller's explicit --fn-env. exec: on top
# of the caller's ambient env, which is not a choice. Pure; missing file = {}.
PROJECT_ENV_FILE = "harbormaster.env"


def project_env(cwd):
    f = Path(cwd) / PROJECT_ENV_FILE
    if not f.is_file():
        return {}
    out = {}
    for raw in f.read_text().splitlines():
        line = raw.strip()
        if not line or line.startswith("#") or "=" not in line:
            continue
        k, v = line.split("=", 1)
        k, v = k.strip(), v.strip()
        if len(v) >= 2 and v[0] == v[-1] and v[0] in "'\"":
            v = v[1:-1]
        if v.startswith("./") or v.startswith("../"):
            v = str((Path(cwd) / v).resolve())
        out[k] = v
    return out


def _ver_tuple(v):
    try:
        return tuple(int(x) for x in str(v).split("."))
    except ValueError:
        return (0,)


# THE DAEMON'S ENVIRONMENT IS NOBODY'S TEST ENVIRONMENT.
#
# The daemon is started by whichever client first needs it, and inherits that
# client's shell. Every suite it boots then inherits the daemon's environment
# (`_boot`: {**os.environ, ...}), because that is how the functions emulator
# runtime gets the env a caller passes with --fn-env. So a variable exported
# by the FIRST caller reaches every LATER caller's suite, for the life of the
# daemon — and nothing shows it.
#
# 2026-09-02: a session-test run (TEST_NOW_MS=1784000000000, LLM_CACHE=1
# exported) started the daemon at 07:04. Every native e2e suite booted after
# that ran its functions emulator on a clock frozen at 2026-07-13; the app
# created its onboarding session with that date, decided the session was
# seven weeks old and not editable, and hid the composer. The onboarding gate
# spec failed on every PR for the rest of the day, and the diagnosis took
# hours because the only trace was a date inside one Firestore document.
#
# So: anything test-only, anything that points at an emulator, and anything a
# lease hands out is stripped from the daemon's own environment — when a
# client spawns it AND when it starts serving (a daemon started by hand from a
# test shell is the same hazard). A caller that wants a suite to see such a
# variable passes it explicitly with --fn-env, which rides on top of this.
SCRUB_EXACT = {
    "TEST_NOW_MS",
    "GCLOUD_PROJECT", "FIREBASE_CONFIG", "FUNCTIONS_EMULATOR",
    "FBPORTS_LEASE_ID", "FBPORTS_BLOCK_BASE",
    "METRO_PORT", "DETOX_UDID", "DETOX_SIM_NAME", "AGENT_SIM_UDID",
}
# LLM_ is the whole family, not LLM_CACHE: 2026-09-13 a session that built
# replay-only mode started the daemon with LLM_REPLAY_ONLY=1, and for five days
# every native e2e suite threw on its first OpenAI call instead of replying.
SCRUB_PREFIXES = ("LLM_", "EMULATOR_")
SCRUB_SUFFIXES = ("_EMULATOR_HOST", "_EMULATOR_PORT")


def scrub_key(k):
    return (k in SCRUB_EXACT or k.startswith(SCRUB_PREFIXES) or k.endswith(SCRUB_SUFFIXES))


def scrubbed_env(env):
    return {k: v for k, v in env.items() if not scrub_key(k)}


def _scrub_environ():
    dropped = sorted(k for k in os.environ if scrub_key(k))
    for k in dropped:
        del os.environ[k]
    return dropped


def _spawn_daemon():
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    log = open(STATE_DIR / "daemon.log", "a")
    subprocess.Popen([sys.argv[0], "serve"], stdout=log, stderr=subprocess.STDOUT,
                     start_new_session=True, env=scrubbed_env(os.environ))


def _ensure():
    v = _daemon_version()
    managed = _managed_recent()
    if v is not None:
        # A managed broker is never replaced by a client: its service manager
        # owns upgrades (restart it to pick up a new install).
        if managed or _ver_tuple(v) >= _ver_tuple(VERSION):
            return
        # A newer client found an older daemon (e.g. a stale node_modules copy
        # started it). Replace it: leases persist in the ledger and every leased
        # process (suites, spawns) runs in its own session, so the successor
        # daemon reloads them and carries on — nothing is torn down.
        try:
            _call("POST", "/shutdown", timeout=5)
        except OSError:
            pass
        for _ in range(50):
            if not _up():
                break
            time.sleep(0.1)
        if _up():
            raise RuntimeError(
                f"daemon {v} is older than this client ({VERSION}) and did not "
                f"shut down — kill the 'harbormaster serve' process and retry")
    if managed:
        # Down, but a service runs it: it is restarting. Wait for it rather than
        # start one of our own that would die with this client. Two minutes: a
        # busy box's startup sweep is not quick — the studio's first managed
        # start reaped 75 leftovers and served after ~40 s (2026-10-09), and a
        # client that gives up early starts a broker that fights the service.
        for _ in range(1200):
            if _up():
                return
            time.sleep(0.1)
        print("harbormaster: the managed broker did not come back in 120s — starting one here", file=sys.stderr)
    _spawn_daemon()
    for _ in range(50):
        if _up():
            return
        time.sleep(0.1)
    raise RuntimeError("daemon failed to start (see ~/.local/state/firebase-ports/daemon.log)")


def _owner(opts):
    """The owning process: --owner, else the CLI's parent (the calling shell/runner).

    `--owner auto` resolves the nearest ancestor that outlives the calling
    script — the useful answer for daemon-spawned leases, where the immediate
    parent exits seconds later. Resolves to no owner when nothing suitable is
    found, leaving TTL and working-dir checks to govern the lease.
    """
    if str(opts.get("owner")).lower() == "auto":
        pid = _durable_ancestor(os.getpid())
        return (pid, _proc_start(pid)) if pid else (None, None)
    pid = int(opts["owner"]) if opts.get("owner") else os.getppid()
    return pid, _proc_start(pid)


def _resolve_cwd(opts):
    cwd = opts.get("cwd") or _find_firebase_dir(os.getcwd())
    if not cwd or not (Path(cwd) / "firebase.json").exists():
        print("no firebase.json here — run inside a project or pass --cwd DIR", file=sys.stderr)
        sys.exit(1)
    return str(Path(cwd).resolve())


def _print(out, fmt):
    ports, pid = out.get("ports", {}), out.get("projectId")
    sim = out.get("sim")
    if fmt == "json":
        print(json.dumps(out))
    elif fmt == "env":
        # Standard Firebase host vars (admin SDK + emulators:exec auto-read these) AND
        # EMULATOR_<SVC>_PORT (what app.config / config.sh / scrub scripts read).
        std = {"firestore": "FIRESTORE_EMULATOR_HOST", "auth": "FIREBASE_AUTH_EMULATOR_HOST",
               "storage": "FIREBASE_STORAGE_EMULATOR_HOST", "database": "FIREBASE_DATABASE_EMULATOR_HOST",
               "pubsub": "PUBSUB_EMULATOR_HOST"}
        if pid:
            print(f"export GCLOUD_PROJECT={pid}")
            print(f"export GOOGLE_CLOUD_PROJECT={pid}")
        for svc, port in ports.items():
            if svc == "metro":
                print(f"export METRO_PORT={port}")            # Expo/Metro dev server + Detox bundle URL
                continue
            if svc in ("android_console", "android_adb"):
                continue                                      # below, as ANDROID_*
            if svc in std:
                print(f"export {std[svc]}=127.0.0.1:{port}")
            print(f"export EMULATOR_{svc.upper()}_PORT={port}")
        if ports.get("android_console"):
            for k, v in _android_env(ports).items():
                print(f"export {k}={v}")
        if sim:
            print(f"export DETOX_UDID={sim['udid']}")          # Detox targets this simulator by UDID
            print(f"export DETOX_SIM_NAME={sim['name']}")
        # The lease id, so a long-running caller can `harbormaster release` a
        # suite it has decided is dead and re-acquire, instead of leaking it
        # until the reaper notices.
        if out.get("leaseId"):
            print(f"export FBPORTS_LEASE_ID={out['leaseId']}")
    else:
        print(f"{out.get('leaseId', '')}  ({pid})".strip())
        for svc, port in ports.items():
            print(f"    {svc:<10} 127.0.0.1:{port}")
        if sim:
            print(f"    {'sim':<10} {sim['name']}  {sim['udid']}")


def _parse(args):
    pos, flags, opts = [], set(), {}
    i = 0
    while i < len(args):
        a = args[i]
        if a.startswith("--"):
            if "=" in a:
                k, v = a[2:].split("=", 1)
                if k == "fn-env":
                    opts.setdefault("fn-env", []).append(v)
                else:
                    opts[k] = v
            elif a[2:] == "fn-env" and i + 1 < len(args):
                opts.setdefault("fn-env", []).append(args[i + 1])
                i += 1
            elif a[2:] in ("cwd", "only", "ttl", "owner", "label", "sim-device", "sim-runtime", "spawn") and i + 1 < len(args):
                opts[a[2:]] = args[i + 1]
                i += 1
            else:
                flags.add(a[2:])
        else:
            pos.append(a)
        i += 1
    return pos, flags, opts


def main():
    if len(sys.argv) < 2 or sys.argv[1] in ("-h", "--help"):
        print(__doc__.strip())
        sys.exit(0)
    cmd = sys.argv[1]
    pos, flags, opts = _parse(sys.argv[2:])
    fmt = "json" if "json" in flags else "env" if "env" in flags else "human"
    only = opts["only"].split(",") if opts.get("only") else None

    def ok(res, verb):
        st, out = res
        if st != 200:
            print(f"{verb} failed: {out.get('error', out)}", file=sys.stderr)
            sys.exit(1)
        return out

    if cmd == "version":
        print(VERSION)
    elif cmd == "serve":
        cmd_serve(managed="managed" in flags)
    elif cmd in ("acquire", "up"):
        _ensure()
        pid, start = _owner(opts)
        _print(ok(_call("POST", "/acquire", {"cwd": _resolve_cwd(opts), "owner_pid": pid,
                                             "owner_start": start, "only": only,
                                             "ttl": int(opts.get("ttl", DEFAULT_TTL)),
                                             "metro": "metro" in flags, "sim": "sim" in flags,
                                             "sim_device": opts.get("sim-device"),
                                             "sim_runtime": opts.get("sim-runtime"),
                                             "env": dict(kv.split("=", 1) for kv in opts.get("fn-env", [])),
                                             "android": "android" in flags}), "acquire"), fmt)
    elif cmd == "down":
        if _up():
            out = _call("POST", "/release-owned", {"owner_pid": os.getppid(), "cwd": _resolve_cwd(opts)})[1]
            print(f"released {out.get('released', 0)} sandbox(es)")
        else:
            print("daemon not running")
    elif cmd == "release":
        if _up() and pos:
            out = _call("POST", "/release", {"leaseId": pos[0]})[1]
            print("released" if out.get("released") else f"not released: {out.get('reason')}")
        else:
            print("nothing to release")
    elif cmd == "reown":
        # harbormaster reown <leaseId> [--owner PID]: the lease is now owned by
        # PID (default: the caller's parent, as for allocate).
        if not (_up() and pos):
            print("usage: harbormaster reown <leaseId> [--owner PID]", file=sys.stderr)
            sys.exit(1)
        pid, start = _owner(opts)
        out = _call("POST", "/reown", {"leaseId": pos[0], "owner_pid": pid, "owner_start": start})[1]
        if not out.get("ok"):
            print(f"not reowned: {out.get('reason')}", file=sys.stderr)
            sys.exit(1)
        print(f"reowned {pos[0]} to {pid}")
    elif cmd == "allocate":
        _ensure()
        spawn = opts.get("spawn")
        # A daemon-spawned or explicitly-detached lease has no owner: it outlives
        # the calling shell/agent by design and is governed by pid liveness + TTL.
        if (spawn or "detach" in flags) and not opts.get("owner"):
            pid, start = None, None
        else:
            pid, start = _owner(opts)
        out = ok(_call("POST", "/allocate", {"owner_pid": pid, "owner_start": start,
                                             "ttl": int(opts.get("ttl", DEFAULT_TTL)),
                                             "label": opts.get("label"),
                                             "metro": "metro" in flags, "sim": "sim" in flags,
                                             "sim_device": opts.get("sim-device"),
                                             "sim_runtime": opts.get("sim-runtime"),
                                             "spawn": spawn,
                                             "spawn_cwd": str(Path(opts["cwd"]).resolve()) if opts.get("cwd") else None,
                                             "android": "android" in flags}),
                 "allocate")
        if fmt == "env":
            # Reserved block, nothing booted — emit only the dev-env extras (plus
            # the base for callers that derive their own ports from it).
            print(f"export FBPORTS_BLOCK_BASE={out['base']}")
            print(f"export FBPORTS_LEASE_ID={out['leaseId']}")
            if out.get("ports", {}).get("metro"):
                print(f"export METRO_PORT={out['ports']['metro']}")
            if out.get("ports", {}).get("android_console"):
                for k, v in _android_env(out["ports"]).items():
                    print(f"export {k}={v}")
            if out.get("sim"):
                print(f"export DETOX_UDID={out['sim']['udid']}")
                print(f"export DETOX_SIM_NAME={out['sim']['name']}")
            if out.get("log"):
                print(f"export FBPORTS_SPAWN_LOG={out['log']}")
        elif fmt == "json":
            print(json.dumps(out))
        else:
            extra = f"  metro {out['ports']['metro']}" if out.get("ports", {}).get("metro") else ""
            extra += f"  sim {out['sim']['udid']}" if out.get("sim") else ""
            extra += (f"  android {out['ports']['android_console']}/{out['ports']['android_adb']}"
                      if out.get("ports", {}).get("android_console") else "")
            extra += f"  spawned pid {out['spawnedPid']}" if out.get("spawnedPid") else ""
            print(f"{out['leaseId']}  base {out['base']}{extra}")
    elif cmd == "exec":
        # harbormaster exec [--cwd DIR] [--only a,b] '<script>'
        # Reserve a free block from the daemon, then run `firebase emulators:exec`
        # on it (which boots the suite, sets FIRESTORE_EMULATOR_HOST etc. for the
        # script, and tears down). This is how projects should invoke emulators:exec
        # so concurrent runs never collide on ports.
        _ensure()
        cwd = _resolve_cwd(opts)
        script = " ".join(pos)
        if not script:
            print("usage: harbormaster exec [--cwd DIR] [--only a,b] '<script>'", file=sys.stderr)
            sys.exit(1)
        me = os.getpid()                      # this process owns the reservation for the run
        res = ok(_call("POST", "/allocate", {"owner_pid": me, "owner_start": _proc_start(me), "label": "exec"}), "exec")
        base, lid = res["base"], res["leaseId"]
        try:
            tmp = _write_injected_config(cwd, _block_ports(base), only)
        except ValueError as e:
            _call("POST", "/release", {"leaseId": lid})
            print(f"exec failed: {e}", file=sys.stderr)
            sys.exit(1)
        try:
            run = ["firebase", "emulators:exec", "--config", tmp]
            if only:
                run += ["--only", ",".join(only)]
            run.append(script)
            # The project's env beats the caller's AMBIENT env here: a key
            # exported in some shell for a one-off script is exactly what
            # harbormaster.env exists to keep out of the suite (project_env).
            rc = subprocess.call(run, cwd=cwd, env={**os.environ, **_with_ports(project_env(cwd), _block_ports(base))})
        finally:
            try:
                _call("POST", "/release", {"leaseId": lid})
            except OSError:
                pass
            p = Path(cwd) / tmp
            if p.exists():
                p.unlink()
        sys.exit(rc)
    elif cmd == "verify":
        # verify <leaseId> — exit 0 iff the lease is FULLY alive. The reuse
        # gate for long-lived sessions (e2e Metro + sim): anything less than
        # fully alive means tear down what's left and re-lease.
        if not pos:
            print("usage: harbormaster verify <leaseId>", file=sys.stderr)
            sys.exit(2)
        _ensure()                          # also upgrades an older daemon first
        out = _call("POST", "/verify", {"leaseId": pos[0]})[1]
        if out.get("ok"):
            print("ok")
        else:
            print("; ".join(out.get("reasons") or [out.get("error", "not ok")]))
            sys.exit(1)
    elif cmd == "doctor":
        # doctor [--fix] — everything alive in the WORLD that the ledger does
        # not account for: pool-port squatters, orphaned firebase runtimes,
        # stray harbormaster sims. --fix evicts them. Exit 1 when findings
        # remain unfixed, so health checks can gate on it.
        _ensure()
        out = ok(_call("POST", "/doctor", {"fix": "fix" in flags}), "doctor")
        findings = out.get("findings", [])
        if not findings:
            print(f"clean — {out.get('leases', 0)} lease(s), no strays.")
            return
        spared = [f for f in findings if not f.get("evict", True)]
        for f in findings:
            tag = "  (not provably ours — never evicted)" if f in spared else ""
            if f["kind"] == "sim":
                print(f"  stray sim    {f['name']}  {f['udid']}{tag}")
            else:
                where = f" port {f['port']}" if f.get("port") else ""
                print(f"  {f['kind']:<12} pid {f['pid']}{where}  {f['cmd']}{tag}")
        evictable = len(findings) - len(spared)
        if out.get("fixed"):
            print(f"{evictable} finding(s) evicted."
                  + (f" {len(spared)} left alone — harbormaster only kills what "
                     f"it can prove it authored; evict those by hand if they're "
                     f"yours." if spared else ""))
        else:
            print(f"{len(findings)} finding(s) — run `harbormaster doctor --fix` to evict"
                  + (f" ({len(spared)} not provably ours, will be left alone)."
                     if spared else "."))
        if not out.get("fixed"):
            sys.exit(1)
    elif cmd in ("status", "leases"):
        if not _up():
            print("daemon not running.")
            return
        st = _call("GET", "/status")[1]
        leases = st.get("leases", [])
        idle = st.get("idleSims")
        if idle:
            print(f"simulators: {idle['booted']} booted, {idle['unleased']} with no lease"
                  + (f"; shut down idle: " + ", ".join(f"{x['name'] or x['udid'][:8]} ({x['upH']}h)" for x in idle["shutDown"][:5])
                     if idle.get("shutDown") else ""))
        comp = st.get("companions")
        if comp and (comp.get("ended") or comp.get("socketsRemoved")):
            print(f"idb companions: {comp['running']} running; last sweep ended {comp['ended']}"
                  f" and removed {comp['socketsRemoved']} socket(s) for gone devices")
        if not leases:
            print("nothing out.")
            return
        for l in leases:
            exp = l.get("expires")
            ttl = "" if exp is None else f"  ttl~{max(0, int(exp - time.time()))}s"
            where = f"base:{l['ports']['base']}" if l["kind"] == "reserved" else f"firestore:{l['ports'].get('firestore')}"
            if l["kind"] != "reserved" and l["ports"].get("metro"):
                where += f" metro:{l['ports']['metro']}"
            if l.get("sim"):
                where += f" sim:{l['sim'][:8]}"
            if l["ports"].get("android_console"):
                where += f" android:{l['ports']['android_console']}"
            print(f"{l['leaseId']:<22} {l['kind']:<9} owner:{str(l.get('ownerPid') or '-'):<7} "
                  f"{'up' if l['up'] else '-':<3} {where}{ttl}  "
                  f"{l.get('label') or ''}  {l.get('cwd') or ''}".rstrip())
    else:
        print(f"Unknown command: {cmd}", file=sys.stderr)
        print("Commands: acquire, up, down, release, allocate, verify, doctor, status, leases, serve", file=sys.stderr)
        sys.exit(1)


if __name__ == "__main__":
    main()
